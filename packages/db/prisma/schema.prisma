generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum ReviewStatus {
  DRAFT
  REVIEWED
  PUBLISHED
}

model Jurisdiction {
  code    String          @id @db.Char(2)
  name    String
  locales ContentLocale[]
}

model ContentLocale {
  id              String       @id
  jurisdictionCode String      @db.Char(2)
  jurisdiction    Jurisdiction @relation(fields: [jurisdictionCode], references: [code], onDelete: Restrict)
  language        String
  script          String
  categories      Category[]
  @@unique([jurisdictionCode, language, script])
}

model Category {
  id              String             @id @default(cuid())
  localeId        String
  locale          ContentLocale      @relation(fields: [localeId], references: [id], onDelete: Restrict)
  licenceCategory String
  key             String
  title           String
  description     String
  questions       QuestionRevision[]
  attempts        PracticeAttempt[]
  @@unique([localeId, licenceCategory, key])
}

model QuestionRevision {
  id              String       @id @default(cuid())
  categoryId      String
  category        Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  key             String
  revision        Int
  prompt          String
  explanation     String
  correctOption   String
  status          ReviewStatus @default(DRAFT)
  reviewer        String?
  reviewedOn      DateTime?    @db.Date
  publishedAt     DateTime?
  sources         Json
  rights          Json
  image           Json?
  content         Json
  createdAt       DateTime    @default(now())
  options         AnswerOption[]
  practiceQuestions PracticeQuestion[]
  duelQuestions DuelQuestion[]
  @@unique([categoryId, key, revision])
  @@index([status, categoryId])
}

model GuestSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique @db.Char(64)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime
  attempts    PracticeAttempt[]
  createdDuels Duel[] @relation("DuelCreator")
  duelPlayers DuelPlayer[]
  @@index([expiresAt])
}

model PracticeAttempt {
  id            String   @id @default(cuid())
  guestId       String
  guest         GuestSession @relation(fields: [guestId], references: [id], onDelete: Cascade)
  requestId     String   @db.Uuid
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryKey   String
  categoryTitle String
  demo          Boolean  @default(false)
  nextPosition  Int      @default(0)
  total         Int
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  completedAt   DateTime?
  questions     PracticeQuestion[]
  @@unique([guestId, requestId])
  @@index([guestId, createdAt])
  @@index([createdAt])
}

model PracticeQuestion {
  id                 String   @id @default(cuid())
  attemptId          String
  attempt            PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionRevisionId String?
  questionRevision   QuestionRevision? @relation(fields: [questionRevisionId], references: [id], onDelete: Restrict)
  position           Int
  prompt             String
  options            Json
  correctOption      String
  explanation        String
  sources            Json
  image              Json?
  answer             PracticeAnswer?
  @@unique([attemptId, position])
}

model PracticeAnswer {
  questionId  String @id
  question    PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionKey   String
  correct     Boolean
  submittedAt DateTime @default(now())
}

model AnswerOption {
  id         String           @id @default(cuid())
  questionId String
  question   QuestionRevision @relation(fields: [questionId], references: [id], onDelete: Cascade)
  key        String
  text       String
  position   Int
  @@unique([questionId, key])
  @@unique([questionId, position])
}

enum DuelPhase {
  WAITING
  READY
  ROUND
  ROUND_RESULT
  FINISHED
  EXPIRED
  ABORTED
}

model Duel {
  id                String @id @default(uuid()) @db.Uuid
  creatorId         String
  creator           GuestSession @relation("DuelCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  requestId         String @db.Uuid
  categoryKey       String
  categoryTitle     String
  demo              Boolean @default(false)
  phase             DuelPhase @default(WAITING)
  version           Int @default(0)
  roundIndex        Int @default(-1)
  rules             Json
  inviteHash        String? @unique @db.Char(64)
  inviteExpiresAt   DateTime
  revealUntil       DateTime?
  reason            String?
  nextDuelId        String? @unique @db.Uuid
  nextDuel          Duel? @relation("DuelRematch", fields: [nextDuelId], references: [id], onDelete: SetNull)
  previousDuel      Duel? @relation("DuelRematch")
  createdAt         DateTime @default(now())
  endedAt           DateTime?
  players           DuelPlayer[]
  questions         DuelQuestion[]
  @@unique([creatorId, requestId])
  @@index([phase, inviteExpiresAt])
  @@index([createdAt])
}

model DuelPlayer {
  id             String @id @default(cuid())
  duelId         String @db.Uuid
  duel           Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  guestId        String
  guest          GuestSession @relation(fields: [guestId], references: [id], onDelete: Cascade)
  seat           Int
  ready          Boolean @default(false)
  connected      Boolean @default(false)
  disconnectedAt DateTime?
  rematchReady   Boolean @default(false)
  @@unique([duelId, guestId])
  @@unique([duelId, seat])
  @@index([guestId])
}

model DuelQuestion {
  id                 String @id @db.Uuid
  duelId             String @db.Uuid
  duel               Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  questionRevisionId String?
  questionRevision   QuestionRevision? @relation(fields: [questionRevisionId], references: [id], onDelete: Restrict)
  position           Int
  snapshot           Json
  opensAt            DateTime?
  deadlineAt         DateTime?
  closedAt           DateTime?
  answers            DuelAnswer[]
  @@unique([duelId, position])
}

model DuelAnswer {
  questionId  String @db.Uuid
  question    DuelQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  seat        Int
  optionKey   String
  correct     Boolean
  elapsedMs   Int
  receivedAt  DateTime
  @@id([questionId, seat])
}
