{
  "name": "@duel/realtime",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@duel/domain": "*",
    "dotenv": "^17.2.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
