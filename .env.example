# Local-only credentials; use separate secrets outside local development.
DATABASE_URL=postgresql://duel:duel_local_only@localhost:5432/duel?schema=public
WEB_ORIGIN=http://localhost:3000
REALTIME_PORT=3001
# Opt-in synthetic interface walkthrough; ignored in production. Requires PostgreSQL.
PRACTICE_DEMO=false
DUEL_QUESTION_SECONDS=20
DUEL_REVEAL_SECONDS=4
DUEL_RECONNECT_SECONDS=20

# Build-time SEO settings. Keep indexing disabled until reviewed content and launch readiness.
# SITE_URL=https://your-public-domain.rs
SEARCH_INDEXING_ENABLED=false

# Optional first-party analytics: requires explicit per-browser consent. Configure both services and rebuild.
ANALYTICS_ENABLED=false

# Development-only layout placeholders. Never activates a real ad provider; ignored in production.
ADS_PREVIEW=false
